# Wiki.js GraphQL API Configuration

# Wiki.js API Endpoint (should end with /graphql)
WIKIJS_API_URL=https://your-wikijs-installation/graphql

# Wiki.js API Token (create in Admin Panel → API Access)
# Permissions needed: read:pages, write:pages, manage:pages
WIKIJS_API_TOKEN=your-api-token-here

# Asset uploads allow PNG/JPEG/GIF/WebP and verify file signatures. Default: 10 MB.
WIKIJS_MAX_UPLOAD_MB=10
# URL downloads are enabled by default; public internet addresses only.
WIKIJS_ALLOW_REMOTE_ASSETS=true

# Server transport: stdio (default) or http
TRANSPORT=stdio

# Streamable HTTP settings (used when TRANSPORT=http)
HTTP_HOST=127.0.0.1
HTTP_PORT=3200
MCP_PATH=/mcp

# Optional static bearer token for /mcp. Leave empty to disable auth.
MCP_AUTH_TOKEN=

# Comma-separated hostnames accepted by /mcp. For non-loopback HTTP_HOST this is required.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional comma-separated exact origins accepted by /mcp.
MCP_ALLOWED_ORIGINS=
